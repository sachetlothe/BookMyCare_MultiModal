# Copy to backend/.env and adjust. Never commit real keys.

# --- Core ---
ENVIRONMENT=development
# Default is a SQLite file in the backend folder (leave DATABASE_URL unset).
# Shared Supabase database (Session pooler, from Supabase -> Connect). Get the real value privately from Member 1:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres?sslmode=require
# Only ONE team member runs migrations on the shared database; everyone else sets this to false.
# AUTO_MIGRATE=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15

# --- Uploaded files (always encrypted with AES-256-GCM before storage) ---
# Generate with: python -m scripts.encrypt_uploads --new-key
# Only used for files uploaded before per-patient keys existed (they move to the patient's own key at
# their next sign-in). Without it, a development key is created in backend/.keys/ (git-ignored).
# With a shared bucket, ALL team members need the SAME key: share it privately.
# FILE_ENCRYPTION_KEY=
# local = backend/uploads on this computer; supabase = private bucket shared by the team
STORAGE_BACKEND=local
# Needed only for STORAGE_BACKEND=supabase (Supabase -> Project Settings -> API Keys -> secret key).
# Server-only: it bypasses row-level security. Never put it in the frontend or in git.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=medical-files
# Each patient's files are sealed with their OWN key, unlocked only by their password at sign-in.
# true  = the patient can view/download their own originals (nobody else can: not the team, not the DB, not the server key alone)
# false = originals are hidden from the patient as well; only extracted results are shown
ALLOW_FILE_DOWNLOAD=true

# Failed logins allowed per 15 minutes before the API answers 429 (per email+IP, and per IP).
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_SECONDS=900
# Set to true only when the API is served over HTTPS (sends Strict-Transport-Security).
HSTS_ENABLED=false

# --- Team features ---
# Staff accounts: python -m scripts.make_staff someone@example.com  (they see anonymous statistics, and a
# patient's data only while that patient allows support access; never original files).
# Statistics groups smaller than this are shown as "<N" so nobody can be singled out.
STATS_MIN_COUNT=5

# --- AI providers (all optional). Without a working provider the app runs in clearly-labelled MOCK mode. ---
# Gemini is the primary provider. Create a key at https://aistudio.google.com/apikey and paste it below.
# Never commit backend/.env; it is git-ignored.
AI_PROVIDER_ORDER=gemini,groq,openrouter
AI_FORCE_MOCK=false
# true  = if no real AI works, show a template summary that is labelled "Mock AI"
# false = show "AI explanation unavailable" instead of any template text
AI_ALLOW_MOCK_FALLBACK=true
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4096
GEMINI_API_KEY=
# Model names are retired regularly (gemini-2.0-flash and groq llama-3.3-70b-versatile no longer work).
# Free-tier limits are per model. Measured 2026-10-25: gemini-3.8-flash hung or returned 503; gemini-3.6-flash allowed only 20 requests/day;
# gemini-3.5-flash-lite was fast and reliable. Check limits for your key at https://aistudio.google.com/rate-limit
# Check https://ai.google.dev/gemini-api/docs/deprecations and https://console.groq.com/docs/deprecations
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# OpenRouter is only used when a model id is set here.
OPENROUTER_MODEL=

# --- Nearby facility search (OpenStreetMap; no key needed) ---
# Only a rounded location (~1 km) is sent; never health data. Set false to hide the search.
FACILITY_SEARCH_ENABLED=true
# Data sources tried in order: nominatim (fast) then overpass (more complete; public servers often busy).
FACILITY_SOURCES=nominatim,overpass
# Overpass servers, tried in order.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# OSM usage policy: identify the app; add a contact e-mail for a public deployment.
OSM_USER_AGENT=BookMyCare/0.1 (educational prototype)
GEOCODE_COUNTRY_CODES=in

# --- OCR (optional). Needed only for scanned PDFs and photos of reports. ---
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Safety messaging ---
EMERGENCY_NUMBER=112
CRISIS_LINE=Tele-MANAS 14416 (India, 24x7 mental health helpline)
